{
  "name": "durable-mmo",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:client && wrangler dev",
    "dev:client": "vite",
    "build": "vite build",
    "build:client": "vite build",
    "deploy": "npm run build:client && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply durable-mmo-auth --local --env local",
    "db:migrate:remote": "wrangler d1 migrations apply durable-mmo-auth --remote",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run",
    "e2e": "node scripts/e2e.mjs",
    "e2e:playtest": "node scripts/e2e-playtest.mjs",
    "dev:local": "npm run build:client && wrangler dev --env local",
    "deploy:prod": "npm run build:client && node scripts/deploy-prod.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^3.2.7",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@cloudflare/think": "^0.23.0",
    "@typesafe-ai/sdk": "^0.7.0",
    "agents": "^0.32.0",
    "ai": "^7.0.159",
    "better-auth": "^1.7.15",
    "html-to-image": "^1.11.13",
    "pixi.js": "^8.22.0",
    "zod": "^4.6.7"
  }
}
