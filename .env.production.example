# Production values for `npm run deploy:prod`. Copy to .env.production (git-ignored).
# D1_DATABASE_ID and TURNSTILE_SITE_KEY go into the generated wrangler.production.jsonc;
# every other non-empty key is uploaded as a Worker secret.

# From: npx wrangler d1 create durable-mmo-auth
D1_DATABASE_ID=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin, https and no trailing slash, e.g. https://durable-mmo.example.workers.dev
BETTER_AUTH_URL=

# Turnstile: set both keys, or leave them empty and set CAPTCHA_DISABLED=1.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# CAPTCHA_DISABLED=1

# Admin accounts (comma-separated emails). Sign up with the address before you deploy.
ADMIN_EMAILS=
